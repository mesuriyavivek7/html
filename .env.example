# Oontu auth service - configuration TEMPLATE. Copy to .env on the server and fill in.
# Server-side only: none of these values may ever be placed in the HTML or any browser code.
# No real values are stored in this file. See docs/AUTH.md.

# Public origin of the app and the allowed redirect base.
APP_ORIGIN=https://app.oontu.example
AUTH_API_BASE_PATH=/api

# Sessions
SESSION_SECRET=
SESSION_COOKIE_NAME=__Host-oontu_session
SESSION_IDLE_TIMEOUT_SECONDS=28800
SESSION_REMEMBER_IDLE_TIMEOUT_SECONDS=2592000
SESSION_ABSOLUTE_TIMEOUT_SECONDS=2592000
CSRF_COOKIE_NAME=oontu_csrf

# Database and rate-limit store
DATABASE_URL=
RATE_LIMIT_STORE_URL=

# Passwords
PASSWORD_HASH=argon2id
PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_LENGTH=128
PASSWORD_MAX_FAILURES=5
PASSWORD_LOCKOUT_SECONDS=900

# Email verification codes (sign-in with a code, and forgot password)
EMAIL_CODE_LENGTH=6
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_RESEND_COOLDOWN_SECONDS=30
EMAIL_CODE_MAX_SENDS_PER_15_MIN=5
EMAIL_CODE_HMAC_SECRET=
EMAIL_PROVIDER=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=no-reply@oontu.example

# Enterprise SSO - per-organisation settings live in the database (sso_connections).
# Fill these only if a managed SSO provider is chosen.
SSO_PROVIDER=
SSO_PROVIDER_CLIENT_ID=
SSO_PROVIDER_CLIENT_SECRET=

# Social sign-in. Leave a pair empty to keep that button hidden.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_LINKEDIN_CLIENT_ID=
OAUTH_LINKEDIN_CLIENT_SECRET=

# Invitations (sent from Team members)
INVITATION_TTL_DAYS=7
