# Copy to .env.local (never committed). dev/setup-db.ps1 writes .env.local with generated passwords.
DATABASE_URL_OWNER=postgres://oontu_owner:CHANGE_ME@localhost:5432/oontu   # owns the schema, runs migrations
DATABASE_URL_APP=postgres://oontu_app:CHANGE_ME@localhost:5432/oontu       # the API: not the owner, no BYPASSRLS
DATABASE_URL_TEST_OWNER=postgres://oontu_owner:CHANGE_ME@localhost:5432/oontu_test
DATABASE_URL_TEST_APP=postgres://oontu_app:CHANGE_ME@localhost:5432/oontu_test
PORT=4000
